#!/bin/sh
# Repeat only an explicitly named bootstrap acquisition when the command crashes (exit 1). Gamma retries exhausted raise out of
# the CLI, so the process exits 1 and the capturing batch can be resumed. Exit 0 is success.
# Exit 2 is a handled failure after capture (dbt or publish); retrying would open a new full
# crawl. Exit 3 is the run lock or a blocked stage. SIGHUP, SIGTERM, and SIGINT stop
# immediately too: the wrapper logs the signal, forwards it to the child, and exits
# 128 plus the signal number so a kill is not retried. Anything other than 1 stops immediately.
# Each attempt appends its output and one "attempt N/M exit=RC" line to a timestamped log under
# .state/logs. BOOTSTRAP_LOG_DIR overrides that directory so tests can stay out of the
# repository's .state. Relative paths resolve from the repository root.
set -eu
cd "$(dirname "$0")/.."

RESUME_BATCH=${BOOTSTRAP_RESUME_BATCH:-}
if [ -n "${BOOTSTRAP_COMMAND:-}" ]; then
  COMMAND=$BOOTSTRAP_COMMAND
  MAY_RETRY=1
elif [ -n "$RESUME_BATCH" ]; then
  case "$RESUME_BATCH" in
    *[!a-zA-Z0-9-]*|*-daily*|*-selected*|*-reconcile*)
      echo "BOOTSTRAP_RESUME_BATCH must name a bootstrap acquisition" >&2
      exit 2
      ;;
  esac
  COMMAND="uv run --locked catalogue refresh --mode bootstrap --resume $RESUME_BATCH"
  MAY_RETRY=1
else
  COMMAND="uv run --locked catalogue refresh --mode bootstrap"
  MAY_RETRY=0
fi
MAX_ATTEMPTS=${BOOTSTRAP_MAX_ATTEMPTS:-20}
RETRY_SLEEP_S=${BOOTSTRAP_RETRY_SLEEP_S:-30}
LOG_DIR=${BOOTSTRAP_LOG_DIR:-.state/logs}

case "$MAX_ATTEMPTS" in
  [1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
  *)
    echo "BOOTSTRAP_MAX_ATTEMPTS must be an integer from 1 to 999, got '$MAX_ATTEMPTS'" >&2
    exit 2
    ;;
esac

case "$RETRY_SLEEP_S" in
  0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
  *)
    echo "BOOTSTRAP_RETRY_SLEEP_S must be an integer from 0 to 999, got '$RETRY_SLEEP_S'" >&2
    exit 2
    ;;
esac

mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/bootstrap-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"

# sh -c does not replace itself, so the command's process is a child of $1.
# Kill with the function's own positional parameters. A variable copied from them
# is global, and the recursive call would overwrite it before this frame's kill.
signal_tree() {
  kids=$(pgrep -P "$1" 2>/dev/null || true)
  for kid in $kids; do
    signal_tree "$kid" "$2"
  done
  kill -s "$2" "$1" 2>/dev/null || true
}

forward_signal() {
  name=$1
  code=$2
  printf '%s wrapper interrupted by SIG%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" >>"$LOG"
  if [ -n "${child_pid:-}" ]; then
    signal_tree "$child_pid" "$name"
  fi
  exit "$code"
}

trap 'forward_signal HUP 129' HUP
trap 'forward_signal TERM 143' TERM
trap 'forward_signal INT 130' INT

attempt=1
child_pid=
while :; do
  rc=0
  sh -c "$COMMAND" >>"$LOG" 2>&1 &
  child_pid=$!
  wait "$child_pid" || rc=$?
  child_pid=
  printf '%s attempt %s/%s exit=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$attempt" "$MAX_ATTEMPTS" "$rc" >>"$LOG"

  if [ "$rc" -eq 0 ]; then
    exit 0
  fi
  # Only an uncaught crash is worth another capture. Exit 2 would recrawl Gamma after dbt
  # or publish already failed. Exit 3 is the lock or a blocked stage.
  if [ "$rc" -ne 1 ]; then
    exit "$rc"
  fi
  if [ "$MAY_RETRY" -eq 0 ]; then
    echo "Capture interrupted. Read the reported batch ID, then set BOOTSTRAP_RESUME_BATCH for explicit resume." >&2
    exit "$rc"
  fi
  if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
    exit "$rc"
  fi
  sleep "$RETRY_SLEEP_S"
  attempt=$((attempt + 1))
done
