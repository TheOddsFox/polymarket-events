git diff --cached --check
env UV_LINK_MODE=copy uv lock --check
env UV_LINK_MODE=copy uv sync --locked
env UV_LINK_MODE=copy uv run --locked ruff check .
env UV_LINK_MODE=copy uv run --locked ruff format --check .
env UV_LINK_MODE=copy uv run --locked catalogue dbt -- parse
env UV_LINK_MODE=copy CATALOGUE_GAMMA_BASE_URL=http://127.0.0.1:9 uv run --locked pytest -q
